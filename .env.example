# 超星学习通签到 - 环境配置模板
# 复制此文件并重命名，填入你的配置
#
# 注意：本项目主要使用 apps/server/src/env.json 进行配置
# 此文件用于文档参考和未来可能的 .env 迁移

# ===== 超星手机端 User-Agent =====
# 从手机端超星 App 抓包获取，用于拍照签到和位置签到
# 在 env.json 中对应 webim.userAgent
CHAOXING_USER_AGENT=

# ===== 环信 IM 凭证（可选，用于 WebSocket 监听模式）=====
WEBIM_TUID=
WEBIM_TOKEN=
WEBIM_NAME=

# ===== 监听配置 =====
# 模式：poll（轮询，默认）或 websocket（IM）
MONITOR_MODE=poll
# 轮询间隔（秒）
MONITOR_POLL_INTERVAL=30

# ===== 拍照签到配置 =====
PHOTO_AUTO=true
PHOTO_DEFAULT_PATH=

# ===== 腾讯云 OCR（可选，用于二维码识别）=====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 高德地图 API Key（可选，用于位置签到地址搜索）=====
# 在 https://lbs.amap.com 免费申请「Web服务」Key
# 也可在 Web 界面左下角「地图设置」中配置
AMAP_API_KEY=
