# 超星学习通签到 - 环境配置模板
# 复制此文件为 .env 后修改。填入的非空值优先于根目录 env.json。

# 后端服务端口
PORT=5000

# 前端开发服务器端口
VITE_PORT=3000

# 前端请求的后端地址（可选；不填时使用当前主机名 + PORT）
# VITE_API_URL=http://localhost:5000

# Serverless 部署时设为 true；本地 Web 服务保持 false
# SERVERLESS=false

# ===== 超星手机端 User-Agent =====
# 从手机端超星 App 抓包获取，用于拍照签到和位置签到
CHAOXING_USER_AGENT=

# ===== 环信 IM 凭证（可选，用于 WebSocket 监听模式）=====
WEBIM_TUID=
WEBIM_TOKEN=
WEBIM_NAME=
# WEBIM_URL=
# WEBIM_EXTRA_HEADERS={"Cookie":"value"}

# ===== 监听配置 =====
# 模式：poll（轮询，默认）或 websocket（IM）
MONITOR_MODE=poll
# 轮询间隔（秒）
MONITOR_POLL_INTERVAL=30

# ===== 拍照签到配置 =====
PHOTO_AUTO=true
PHOTO_DEFAULT_PATH=

# ===== 腾讯云 OCR（可选，用于二维码识别）=====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 高德地图 API Key（可选，用于位置签到地址搜索）=====
# 在 https://lbs.amap.com 免费申请「Web服务」Key
# 也可在 Web 界面左下角「地图设置」中配置
AMAP_API_KEY=
