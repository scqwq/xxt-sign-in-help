/*.http

# ===== 敏感文件（切勿提交到远程仓库）=====

# SQLite 数据库（包含用户登录凭证）
*.db
*.db-shm
*.db-wal

# env.json 配置（包含手机端 UA、环信凭证等敏感信息）
apps/server/src/env.json
apps/server/build/env.json
apps/server/build/configs/env.json

# 签到监听日志（包含用户手机号）
apps/server/src/logs/
apps/server/build/logs/

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
env.json